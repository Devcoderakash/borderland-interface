# Backend Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Server Configuration (Requires service role key for admin privileges)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Cashfree Payment Gateway Credentials (Server-only — NEVER expose to browser)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=sandbox # "sandbox" or "production"

# Cron / Automation Security
CRON_SECRET=your_cron_secret
