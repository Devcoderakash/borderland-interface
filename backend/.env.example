# Backend Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Server Configuration (Requires service role key for admin privileges)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay Payment Gateway Credentials (Server-only — NEVER expose to browser)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Cron / Automation Security
CRON_SECRET=your_cron_secret

# Automated Email Delivery Configuration (Choose Resend OR Gmail SMTP)
EMAIL_SENDER_NAME="APEX//1.0 Team"
EMAIL_SENDER_EMAIL="lodhiakash286@gmail.com"
EMAIL_REPLY_TO="lodhiakash286@gmail.com"

# Option A: Resend API (Recommended)
RESEND_API_KEY=re_your_resend_api_key

# Option B: Gmail SMTP (Use Google Account App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lodhiakash286@gmail.com
SMTP_PASS=your_gmail_app_password
